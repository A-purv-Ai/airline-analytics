{
  "name": "Airline Analytics",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false,
      "dockerDashComposeVersion": "v2"
    }
  },
  "forwardPorts": [8080, 8501],
  "portsAttributes": {
    "8080": { "label": "Airflow UI", "onAutoForward": "notify" },
    "8501": { "label": "Streamlit Dashboard", "onAutoForward": "notify" }
    // onAutoForward modes:
    //   "openBrowser"        : forward and open the browser automatically (your current setting)
    //   "openBrowserOnce"    : open the browser only the first time per session
    //   "openPreview"        : open in the built-in preview panel
    //   "notify"             : show a notification with an Open button, nothing opens by itself
    //   "silent"             : forward quietly, no notification, no tab
    //   "ignore"             : do not forward this port automatically
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "innoverio.vscode-dbt-power-user",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ]
    }
  },
    "postCreateCommand": "pip install dbt-snowflake==1.9.0 && cp .env.example .env && echo '✅ Codespace ready! Edit .env with your credentials, then run: docker compose up -d'"
}
